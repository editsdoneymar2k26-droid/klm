2026-05-14 08:13:07 [debug] [Update] message | user=7703198664 | @myrellazx | action="// -----------------------------------------
// HYPERCUT STORE BOT -- Entry Point
// -----------------------------------------

import 'dotenv/config';
import { createBot } from './bot/bot';
import { startExpirationWorker, stopExpirationWorker } from './workers/expiration.worker';
import { startWebhookServer } from './workers/webhook.server';
import { logger } from './utils/logger';
import { env } from './config/env';

async function bootstrap(): Promise<void> {
  logger.info('====================================');
  logger.info('  HyperCut Store BOT -- Iniciando');
  logger.info(  Ambiente: ${env.NODE_ENV});
  logger.info('====================================');

  const bot = createBot();

  // Worker de expiracao de reservas e PIX
  startExpirationWorker();

  // Servidor HTTP para receber webhooks do gateway
  const webhookServer = startWebhookServer(bot);

  // Graceful shutdown
  const shutdown = async (signal: string) => {
    logger.info([Shutdown] Sinal ${signal} recebido. Encerrando...);
    stopExpirationWorker();
    webhookServer.close();
    bot.stop(signal);
    process.exit(0);
  };

  process.once('SIGINT', () => shutdown('SIGINT'));
  process.once('SIGTERM', () => shutdown('SIGTERM'));

  await bot.launch();
  logger.info(Bot @${env.BOT_USERNAME} online.);
  logger.info(Webhook aguardando em: POST http://localhost:${env.WEBHOOK_PORT}/webhook/pix);
}

bootstrap().catch((err) => {
  logger.error('[Bootstrap] Erro fatal:', err);
  process.exit(1);
});"
